# Database (asyncpg connection string)
DATABASE_URL=postgresql://leads:leads@localhost:5432/leads

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Runtime environment: dev | staging | prod
RUN_ENV=dev

# NBB CBSO Authentic Data API (fill in when the NBB source prompt ships)
# NBB_CBSO_API_KEY=
# NBB_CBSO_CLIENT_NUMBER=

# Brave Search API (optional fallback for cross-validation)
BRAVE_SEARCH_API_KEY=
