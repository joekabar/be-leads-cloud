# Copy this file to hetzner/.env and fill in the values.
# NEVER commit hetzner/.env to git.

# Postgres credentials (used by pg service AND the DATABASE_URL for app containers)
POSTGRES_USER=leads
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=leads

# Full DSN — must use 'pg' as host (docker-compose internal network hostname)
DATABASE_URL=postgresql://leads:CHANGE_ME_STRONG_PASSWORD@pg:5432/leads

# Optional: Brave Search API key for cross-validation (can be blank)
BRAVE_SEARCH_API_KEY=

# Optional: NBB CBSO API key for financial data (can be blank)
NBB_CBSO_API_KEY=

# Application settings
LOG_LEVEL=INFO
RUN_ENV=prod
